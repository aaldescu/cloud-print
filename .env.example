# Copiază acest fișier în .env și completează valorile:  cp .env.example .env
# Folosit de docker-compose.yml (serverul cloud). NU comite fișierul .env.

# Parola de login pentru interfața web (OBLIGATORIE — serverul e public).
CLOUDPRINT_PASSWORD=schimba-ma-cu-o-parola-lunga-si-secreta

# Utilizatorul de login (opțional, implicit "admin").
#CLOUDPRINT_USER=admin

# Tokenul cu care agentul de pe Raspberry Pi se autentifică la server.
# Trebuie să fie IDENTIC cu cel din /etc/cloud-print-agent.env de pe Pi.
# Generează-l cu:  python3 -c "import secrets; print(secrets.token_hex(24))"
CLOUDPRINT_AGENT_TOKEN=schimba-ma-cu-un-token-lung-si-secret
